<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="345.0" prefWidth="385.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controller.DispatcherDispatchUnitsController">
   <children>
      <Label layoutX="20" layoutY="20" text="Select Truck:" />
      <ComboBox fx:id="TrucksCB" layoutX="120" layoutY="20" />

      <Label layoutX="20" layoutY="60" text="Select Team:" />
      <ComboBox fx:id="TeamsCB" layoutX="120" layoutY="60" />

      <Label layoutX="20" layoutY="100" text="Tools:" />
      <ComboBox fx:id="ToolsCB" layoutX="120" layoutY="100" />

      <Button layoutX="120" layoutY="140" onAction="handleDispatchOA" text="Dispatch" />
      <Button layoutX="118.0" layoutY="196.0" mnemonicParsing="false" onAction="#backOA" text="Back to Dashboard" />
   </children>
</AnchorPane>
