<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.DispatcherIncidentListController">
    <children>
        <Label layoutX="20" layoutY="20" text="Incident List" />
        <ListView fx:id="listIncidents" layoutX="20" layoutY="50" prefHeight="200" prefWidth="300" />
        <Button fx:id="btnViewReport" layoutX="20" layoutY="260" text="View Report" onAction="handleViewReportOA"/>
        <Button fx:id="btnBack" layoutX="120" layoutY="260" text="Back" onAction="handleBackOA"/>
    </children>
</AnchorPane>
