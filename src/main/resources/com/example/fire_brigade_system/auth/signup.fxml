<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fire_brigade_system.Auth.signupController"
            prefWidth="300" prefHeight="350">

    <Label layoutX="95" layoutY="20" text="Create Account" style="-fx-font-size:18px;"/>
    <TextField fx:id="userIdField" layoutX="50" layoutY="60" promptText="User ID (6 digits)" prefWidth="200"/>
    <PasswordField fx:id="passwordField" layoutX="50" layoutY="100" promptText="Password (min 6 chars)" prefWidth="200"/>
    <PasswordField fx:id="confirmPasswordField" layoutX="50" layoutY="140" promptText="Confirm Password" prefWidth="200"/>
    <TextField fx:id="phoneField" layoutX="50" layoutY="180" promptText="Phone Number" prefWidth="200"/>
    <Label fx:id="messageLabel" layoutX="50" layoutY="215" textFill="red" prefWidth="200"/>

    <Button text="Sign Up" layoutX="110" layoutY="250" prefWidth="80" onAction="#handleRegister"/>
    <Button text="Back to Login" layoutX="110" layoutY="290" prefWidth="80" onAction="#handleBackToLogin"/>
    <TextField fx:id="roleField" layoutX="50" layoutY="220" promptText="Role" prefWidth="200"/>

</AnchorPane>
