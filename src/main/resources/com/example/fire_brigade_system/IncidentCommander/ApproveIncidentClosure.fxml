<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.IncidentCommander.ApproveIncidentClosureController">
    <children>
        <Label layoutX="188.0" layoutY="14.0" text=" Approve Incident Closure ">
            <font>
                <Font name="System Bold" size="18.0" />
            </font></Label>
        <Label layoutX="53.0" layoutY="90.0" text="Safety Checklist Complete" />
        <Label layoutX="51.0" layoutY="192.0" text="All Teams Cleared " />
        <Label layoutX="40.0" layoutY="255.0" text="Final Remarks: " />
        <TextArea fx:id="finalRemarksTextArea" layoutX="37.0" layoutY="280.0" prefHeight="106.0" prefWidth="302.0" />
        <Button layoutX="419.0" layoutY="354.0" mnemonicParsing="false" onAction="#closeOnAction" prefHeight="25.0" prefWidth="127.0" text="Close " />
        <Label layoutX="53.0" layoutY="142.0" text="All Equipment Returned :" />
        <RadioButton fx:id="equipmentYesRB" layoutX="213.0" layoutY="142.0" mnemonicParsing="false" text="Yes">
            <toggleGroup>
                <ToggleGroup fx:id="grB" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="tmClearedYesRB" layoutX="213.0" layoutY="192.0" mnemonicParsing="false" text="Yes">
            <toggleGroup>
                <ToggleGroup fx:id="grC" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="tmClearedNoRB" layoutX="332.0" layoutY="192.0" mnemonicParsing="false" text="No" toggleGroup="$grC" />
        <RadioButton fx:id="safetyYesRB" layoutX="215.0" layoutY="91.0" mnemonicParsing="false" text="Yes">
            <toggleGroup>
                <ToggleGroup fx:id="grA" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="safetyNoRB" layoutX="332.0" layoutY="92.0" mnemonicParsing="false" text="No" toggleGroup="$grA" />
        <RadioButton fx:id="equipmentNoRB" layoutX="332.0" layoutY="142.0" mnemonicParsing="false" text="No" toggleGroup="$grB" />
    </children>
</AnchorPane>
