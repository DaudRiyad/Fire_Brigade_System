<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.IncidentCommander.AllocateResourcesController">
    <children>
        <Label layoutX="157.0" layoutY="14.0" text="Allocate Resources">
            <font>
                <Font name="System Bold" size="18.0" />
            </font></Label>
        <Label layoutX="8.0" layoutY="76.0" prefHeight="17.0" prefWidth="76.0" text="Firefighter  :" />
        <Label layoutX="6.0" layoutY="131.0" prefHeight="17.0" prefWidth="53.0" text="Trucks" />
        <Label layoutX="3.0" layoutY="185.0" prefHeight="17.0" prefWidth="87.0" text="Equipment" />
        <ComboBox fx:id="firefighterComboBox" layoutX="90.0" layoutY="72.0" prefWidth="150.0" />
        <ComboBox fx:id="trucksComboBox" layoutX="90.0" layoutY="127.0" prefWidth="150.0" />
        <ComboBox fx:id="equipmentComboBox" layoutX="90.0" layoutY="181.0" prefWidth="150.0" />
        <Button layoutX="109.0" layoutY="240.0" mnemonicParsing="false" onAction="#addButtonOA" prefHeight="25.0" prefWidth="97.0" text="Add" />
        <TableView fx:id="allocateResourcesTableView" layoutX="250.0" layoutY="75.0" prefHeight="155.0" prefWidth="336.0">
            <columns>
                <TableColumn fx:id="fireFighterCol" prefWidth="109.0" text="Fire Fighter " />
                <TableColumn fx:id="trucksCol" prefWidth="106.0" text="Trucks" />
                <TableColumn fx:id="equipmentCol" prefWidth="120.0" text="Equipment" />
            </columns>
        </TableView>
        <Button layoutX="399.0" layoutY="353.0" mnemonicParsing="false" onAction="#confirmResourcesOA" text="Confirm Resources" />
        <Label fx:id="outputLabel" layoutX="21.0" layoutY="324.0" prefHeight="43.0" prefWidth="132.0" text="Label" />
    </children>
</AnchorPane>
