<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.fire_brigade_system.Controllers.FireChief.ActiveIncidentsController" prefWidth="400" prefHeight="200">
    <children>
        <Label layoutX="30" layoutY="20" text="Active Incidents"/>
        <ListView fx:id="incidentsListView" layoutX="30" layoutY="50" prefWidth="320" prefHeight="90"/>
        <Button layoutX="30" layoutY="150" text="View Details" onAction="#handleViewIncident"/>
        <Button layoutX="150" layoutY="150" text="Return" onAction="#handleReturn"/>
    </children>
</AnchorPane>
