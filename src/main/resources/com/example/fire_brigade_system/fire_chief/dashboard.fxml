<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250" prefWidth="400" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.fire_brigade_system.Controllers.FireChief.DashboardController">
    <children>
        <Label layoutX="30" layoutY="30" text="Fire Chief Dashboard" />
        <Button layoutX="30" layoutY="70" onAction="#handleActiveIncidents" prefHeight="25.0" prefWidth="117.0" text="Active Incidents" />
        <Button layoutX="30" layoutY="110" onAction="#handleIncidentEvaluation" text="Incident Evaluation" />
        <Button layoutX="30" layoutY="150" onAction="#handleResponseStrategy" text="Response Strategy" />
        <Button layoutX="200" layoutY="70" onAction="#handleParamedicApproval" text="Paramedic Approval" />
        <Button layoutX="200" layoutY="110" onAction="#handleMutualAid" prefHeight="25.0" prefWidth="123.0" text="Mutual Aid" />
        <Button layoutX="200" layoutY="150" onAction="#handleCommandCenter" prefHeight="25.0" prefWidth="123.0" text="Command Center" />
        <Button layoutX="30" layoutY="190" onAction="#handleIncidentLogs" prefHeight="25.0" prefWidth="115.0" text="Incident Logs" />
    </children>
</AnchorPane>
