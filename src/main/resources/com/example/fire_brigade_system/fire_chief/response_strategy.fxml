<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.fire_brigade_system.Controllers.FireChief.ResponseStrategyController" prefWidth="400" prefHeight="220">
    <children>
        <Label layoutX="30" layoutY="20" text="Response Strategy"/>
        <TextField fx:id="numTrucksField" layoutX="30" layoutY="60" prefWidth="100" promptText="Trucks"/>
        <TextField fx:id="numTeamsField" layoutX="140" layoutY="60" prefWidth="100" promptText="Teams"/>
        <ComboBox fx:id="equipComboBox" layoutX="250" layoutY="60" prefWidth="100" promptText="Equipment"/>
        <Button layoutX="30" layoutY="120" text="Confirm Plan" onAction="#handleConfirmPlan"/>
        <Label fx:id="messageLabel" layoutX="30" layoutY="160"/>
    </children>
</AnchorPane>
