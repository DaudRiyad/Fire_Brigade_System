<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.fire_brigade_system.Controllers.FireChief.CommandCenterController" prefWidth="340" prefHeight="150">
    <children>
        <Label layoutX="30" layoutY="20" text="Command Center"/>
        <TextField fx:id="instructionField" layoutX="30" layoutY="50" prefWidth="180" promptText="Instruction"/>
        <ComboBox fx:id="priorityComboBox" layoutX="220" layoutY="50" prefWidth="80" promptText="Priority"/>
        <Button layoutX="30" layoutY="90" text="Send Order" onAction="#handleSendOrder"/>
        <Label fx:id="messageLabel" layoutX="120" layoutY="90"/>
    </children>
</AnchorPane>
