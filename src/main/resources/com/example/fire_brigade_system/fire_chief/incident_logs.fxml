<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.fire_brigade_system.Controllers.FireChief.IncidentLogsController" prefWidth="350" prefHeight="180">
    <children>
        <Label layoutX="30" layoutY="20" text="Incident Logs"/>
        <ComboBox fx:id="logsComboBox" layoutX="30" layoutY="50" prefWidth="200" promptText="Select Incident"/>
        <Button layoutX="30" layoutY="90" text="View Log" onAction="#handleViewLog"/>
        <Button layoutX="130" layoutY="90" text="Archive Log" onAction="#handleArchiveLog"/>
        <Label fx:id="messageLabel" layoutX="30" layoutY="130"/>
    </children>
</AnchorPane>

