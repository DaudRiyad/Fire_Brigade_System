<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.FireInspector.ConductFollowUpInspectionsController">
    <children>
        <Label layoutX="234.0" layoutY="24.0" text="Follow-Up Inspection Panel">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="42.0" layoutY="75.0" text="Schedule Date:" />
        <Label layoutX="39.0" layoutY="119.0" text="Compliance Status:" />
        <Label layoutX="36.0" layoutY="211.0" text="Findings / Notes:" />
        <Button layoutX="426.0" layoutY="349.0" mnemonicParsing="false" onAction="#logInspectionRsltOnAction" text="Log Inspection Results" />
        <DatePicker fx:id="scheduleDatePicker" layoutX="190.0" layoutY="71.0" prefHeight="25.0" prefWidth="149.0" />
        <TextArea fx:id="notesTextArea" layoutX="32.0" layoutY="252.0" prefHeight="116.0" prefWidth="200.0" />
        <Label layoutX="39.0" layoutY="165.0" text="Unsolved violation : " />
        <TextField fx:id="ViolationTF" layoutX="189.0" layoutY="161.0" />
        <RadioButton fx:id="yesRB" layoutX="189.0" layoutY="119.0" mnemonicParsing="false" prefHeight="17.0" prefWidth="64.0" text="Yes">
            <toggleGroup>
                <ToggleGroup fx:id="tg" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="noRB" layoutX="276.0" layoutY="119.0" mnemonicParsing="false" prefHeight="17.0" prefWidth="64.0" text="No" toggleGroup="$tg" />
    </children>
</AnchorPane>
