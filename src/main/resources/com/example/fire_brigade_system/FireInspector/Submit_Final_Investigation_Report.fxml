<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.FireInspector.SubmitFinalInvestigationReportController">
    <children>
        <Label layoutX="196.0" layoutY="14.0" text="Final Fire Investigation Report">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="76.0" layoutY="77.0" text="Incident Id :" />
        <Label layoutX="76.0" layoutY="125.0" text="Type " />
        <Label layoutX="76.0" layoutY="158.0" text="Location " />
        <Label layoutX="79.0" layoutY="192.0" text="Severty Label :" />
        <Label layoutX="78.0" layoutY="238.0" text="Improvement List:" />
        <ComboBox fx:id="incidentICB" layoutX="225.0" layoutY="73.0" onAction="#incidentIdOA" prefWidth="150.0" />
        <ComboBox fx:id="severtyLabelCB" layoutX="225.0" layoutY="188.0" prefWidth="150.0" />
        <ComboBox fx:id="improvementListCB" layoutX="225.0" layoutY="234.0" prefWidth="150.0" />
        <Label fx:id="reportoutputLabel" layoutX="9.0" layoutY="282.0" prefHeight="89.0" prefWidth="221.0" text="Label" wrapText="true" />
        <Button layoutX="308.0" layoutY="359.0" mnemonicParsing="false" onAction="#createReportOnaction" text="Create Report" />
        <Label fx:id="typeLabel1" layoutX="226.0" layoutY="125.0" prefHeight="17.0" prefWidth="149.0" text="Label" />
        <Label fx:id="locationlabel1" layoutX="228.0" layoutY="158.0" prefHeight="17.0" prefWidth="149.0" text="Label" />
    </children>
</AnchorPane>
