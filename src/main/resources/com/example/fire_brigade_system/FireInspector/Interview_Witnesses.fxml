<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.FireInspector.InterviewWitnessesController">
    <children>
        <Label layoutX="161.0" layoutY="14.0" text="Witness Interview Module">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="14.0" layoutY="100.0" text="Select Witness:" />
        <Label layoutX="14.0" layoutY="267.0" text="Tag as Key Statement:" />
        <Label layoutX="11.0" layoutY="192.0" text="Interview Summary:" />
        <ComboBox fx:id="witnessCB" layoutX="122.0" layoutY="96.0" prefWidth="150.0" />
        <TextArea fx:id="summaryTA" layoutX="122.0" layoutY="152.0" prefHeight="98.0" prefWidth="200.0" />
        <Button layoutX="183.0" layoutY="365.0" mnemonicParsing="false" text="Archive Interview with Incident" />
        <Button layoutX="467.0" layoutY="365.0" mnemonicParsing="false" onAction="#generateReportOA" text="Generate Report" />
        <CheckBox fx:id="checkbox1" layoutX="143.0" layoutY="267.0" mnemonicParsing="false" text="&quot;I saw flames near the kitchen.&quot;" />
        <CheckBox fx:id="checkbox2" layoutX="143.0" layoutY="298.0" mnemonicParsing="false" text="&quot;The alarm didn’t ring.&quot;" />
        <CheckBox fx:id="checkbox3" layoutX="143.0" layoutY="322.0" mnemonicParsing="false" text="&quot;There was a spark before the fire.&quot;" />
        <TextArea fx:id="interviewLabel" layoutX="355.0" layoutY="100.0" prefHeight="168.0" prefWidth="200.0" wrapText="true" />
        <Label layoutX="424.0" layoutY="76.0" text="Interview">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
