<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="475.0" prefWidth="468.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.controller.PSOSafetyChecklistController">
    <children>
        <Label layoutX="20" layoutY="20" text="Safety Checklist" />
        <CheckBox fx:id="crowdControlCHB" layoutX="20" layoutY="50" text="Crowd Control Done" />
        <CheckBox fx:id="gasLeakCHB" layoutX="20" layoutY="80" text="Gas Leak Checked" />
        <Button layoutX="20" layoutY="120" onAction="handleSubmitOA" text="Submit" />
      <CheckBox fx:id="areaDetectionCHB" layoutX="202.0" layoutY="50.0" mnemonicParsing="false" text="Minimum Danger Area detection" />
      <Button layoutX="42.0" layoutY="238.0" mnemonicParsing="false" onAction="#backOA" text="Back" />
    </children>
</AnchorPane>
