<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fire_brigade_system.Auth.ResetPasswordController"
            prefWidth="300" prefHeight="250">

    <Label layoutX="95" layoutY="20" text="Reset Password" style="-fx-font-size:18px;"/>
    <PasswordField fx:id="newPasswordField" layoutX="50" layoutY="60" promptText="New Password (min 6 chars)" prefWidth="200"/>
    <PasswordField fx:id="confirmPasswordField" layoutX="50" layoutY="100" promptText="Confirm Password" prefWidth="200"/>
    <Label fx:id="messageLabel" layoutX="50" layoutY="135" textFill="red" prefWidth="200" wrapText="true"/>
    <Button text="Confirm" layoutX="110" layoutY="170" prefWidth="80" onAction="#handleConfirm"/>
</AnchorPane>
