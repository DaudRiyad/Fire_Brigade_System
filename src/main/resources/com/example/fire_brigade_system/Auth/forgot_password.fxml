<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fire_brigade_system.Auth.ForgetPasswordController"
            prefWidth="300" prefHeight="350">

    <Label layoutX="95" layoutY="20" text="Forgot Password" style="-fx-font-size:18px;"/>
    <TextField fx:id="userIdField" layoutX="50" layoutY="60" promptText="User ID (6 digits)" prefWidth="200"/>
    <TextField fx:id="phoneField" layoutX="50" layoutY="100" promptText="Phone Number" prefWidth="200"/>
    <Button text="Get Code" layoutX="110" layoutY="140" prefWidth="80" onAction="#handleGetCode"/>

    <TextField fx:id="codeField" layoutX="50" layoutY="180" promptText="Enter Verification Code" prefWidth="200"/>
    <Label fx:id="messageLabel" layoutX="50" layoutY="215" textFill="red" prefWidth="200"/>

    <Button text="Next" layoutX="110" layoutY="250" prefWidth="80" onAction="#handleNext"/>
</AnchorPane>
