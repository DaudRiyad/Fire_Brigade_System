<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fire_brigade_system.LoginController">
    <children>
        <Label layoutX="123.0" layoutY="114.0" text="User ID :" />
        <Label layoutX="118.0" layoutY="162.0" text="Password :" />
        <TextField fx:id="userIDTextField" layoutX="226.0" layoutY="110.0" prefHeight="25.0" prefWidth="160.0" />
        <PasswordField fx:id="passwordTextField" layoutX="226.0" layoutY="158.0" prefHeight="25.0" prefWidth="160.0" />
        <Button layoutX="455.0" layoutY="331.0" mnemonicParsing="false" onAction="#createAccountOnAction" text="Create Account" />
        <Button layoutX="259.0" layoutY="294.0" mnemonicParsing="false" onAction="#logInButtonOnAction" text="Log In" />
        <ComboBox fx:id="accountTypeComboBox" layoutX="226.0" layoutY="210.0" prefHeight="25.0" prefWidth="160.0" />
        <Label layoutX="118.0" layoutY="214.0" text="Account Type :" />
        <Label fx:id="loginOutputLabel" layoutX="30.0" layoutY="318.0" prefHeight="52.0" prefWidth="182.0" text="Label" wrapText="true" />
    </children>
</AnchorPane>
